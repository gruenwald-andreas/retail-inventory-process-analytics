        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph AS_IS [\&quot;AS-IS PROCESS: Manual &amp; Static Replenishment\&quot;]\n        A1([Start: Daily Store Operations]) --&gt; A2[Manual visual shelf check by staff]\n        A2 --&gt; A3{Stock visibly low?}\n        A3 -- No --&gt; A4[No order placed]\n        A3 -- Yes --&gt; A5[Place fixed standard order]\n        A5 --&gt; A6[High weekend demand / Short shelf life]\n        A6 --&gt; A7([Result: Out-of-Stock gaps &amp; High shrinkage])\n    end\n\n    subgraph TO_BE [\&quot;TO-BE PROCESS: Automated SQL &amp; Data-Driven Replenishment\&quot;]\n        B1([Start: Daily POS &amp; Inventory Sync]) --&gt; B2[ETL Pipeline loads data into SQL Database]\n        B2 --&gt; B3[Automated SQL Query checks Stock vs. Dynamic Reorder Point]\n        B3 --&gt; B4{Threshold breached or weekend peak?}\n        B4 -- No --&gt; B5[Maintain current stock]\n        B4 -- Yes --&gt; B6[Calculate dynamic order based on sales &amp; shelf life]\n        B6 --&gt; B7[Trigger automated replenishment order]\n        B7 --&gt; B8([Result: Minimized stockouts &amp; Reduced spoilage])\n    end\n\n    AS_IS -. \&quot;Process Optimization via SQL &amp; Python\&quot; .-&gt; TO_BE\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="HY7MKgQpBmwnw85KXJRX-1">
